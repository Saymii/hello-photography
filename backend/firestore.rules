rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Future backend policy scaffold, not deployed or connected to this app.
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    match /catalog/{document} {
      // Premium content must be delivered by an entitlement-checking backend.
      allow read: if resource.data.published == true && resource.data.premium == false;
      allow write: if admin();
    }
    match /users/{uid}/favorites/{pose} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /entitlements/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // Only a trusted Admin SDK backend may grant access.
    }
    match /{document=**} { allow read, write: if false; }
  }
}
